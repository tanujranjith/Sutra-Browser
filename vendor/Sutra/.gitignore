node_modules/
.pnpm-store/

# Package-manager caches and diagnostic logs. Keep lockfiles and package
# manifests tracked; these paths are regenerated per machine.
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local secrets / env files (none currently committed — keep it that way)
.env
.env.*
!.env.example

# Private key and certificate material belongs in a local secret store, never
# beside the public Supabase schema, migrations, or runtime configuration.
*.pem
*.key
*.p12
*.pfx
*.crt

# Vercel CLI local project link (machine-specific project/org IDs)
.vercel/

# Claude Code local session state (was previously excluded only via
# .git/info/exclude, which isn't shared — codified here so it's ignored
# for every clone, not just this machine)
.claude/scheduled_tasks.lock
.claude/
.codex/
.agents/

# Editor / IDE folders
.vscode/
.idea/

# Playwright / test artifacts (generated; never committed)
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright/
coverage/
output/playwright/
.tmp/

# Staged GitHub Pages production artifact (generated by `npm run build:deploy`)
.deploy/

# Supabase CLI local state. Keep schema.sql, sync-schema.sql, migrations, and
# other reviewed configuration trackable.
supabase/.temp/
supabase/.branches/

# Local throwaway analysis helpers (one-off migration/diagnostic scripts)
scripts/_*.mjs
scripts/_*.js

# Generated local audit artifacts (not app files)
security-artifacts/
/design-qa-*.png

# Marketing / investor material (not part of the app or the GitHub Pages deploy)
pitch-decks/
product-documentation/
docs/review/

# Local landing-page experiment. Keep the working files on this machine; the
# canonical public landing page remains HomePage.html unless explicitly changed.
/NewLandingPage/

# Launch film: large rendered media (frames/MP4s/WAVs ~2GB) + generated artifacts.
# Marketing output, not part of the app. Sources stay on disk under launch-film/.
launch-film/

# Stale pre-rebrand assets (no longer referenced by any page; brand checks assert this)
assets/legacy/mascot.png
assets/legacy/noteflow-daily-view.png
assets/legacy/noteflow-favicon-64.png
assets/legacy/noteflow-favicon.png
assets/legacy/noteflow-text-editing.png

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.swp
*.swo
*~
*.orig
*.rej

# Local encrypted workspace exports. Source fixtures and all app assets stay
# trackable because these patterns are limited to Sutra's generated root names.
/sutra_workspace_*.sutra
/sutra_emergency_workspace_*.sutra
/sutra_drive_workspace_*.sutra
