{
  "schemaVersion": 2,
  "description": "Machine-readable portability and sync decision matrix. A workspace-field decision applies recursively to every durable descendant unless a more-specific nested or asset contract overrides it.",
  "classificationCategories": {
    "record": "Record-level synchronized collection",
    "ordered": "Ordered synchronized collection",
    "atomic": "Atomic synchronized section",
    "asset": "Synchronized encrypted asset",
    "reconstructed": "Portable but reconstructed from another canonical field",
    "deviceLocal": "Deliberately device-local",
    "secret": "Secret or credential, never synchronized",
    "ephemeral": "Ephemeral or regenerable, never synchronized",
    "compatibility": "Deprecated compatibility field that must still survive"
  },
  "workspaceTopLevelFields": [
    "version",
    "schema",
    "migrationHistory",
    "pages",
    "spaces",
    "tasks",
    "taskOrder",
    "timeBlocks",
    "streaks",
    "habitTracker",
    "collegeTracker",
    "academicWorkspace",
    "collegeAppWorkspace",
    "lifeWorkspace",
    "businessWorkspace",
    "apStudyWorkspace",
    "homeworkWorkspace",
    "reviewWorkspace",
    "courseWorkspace",
    "attachmentLinks",
    "pdfDocuments",
    "pdfAnnotations",
    "schoolSchedule",
    "gradePlanner",
    "semesterSetup",
    "cramSessions",
    "trash",
    "focusSessions",
    "protectedTime",
    "taskDependencies",
    "studySessions",
    "masteryRecords",
    "confidenceObservations",
    "studentDecisionState",
    "assistantPermissions",
    "assistantMemory",
    "syncAuditLog",
    "workspaceMeta",
    "privateDocuments",
    "sharedStudySessions",
    "operatingManual",
    "portfolioWorkspace",
    "testingHub",
    "focusTemplates",
    "customTabs",
    "splitPaneContexts",
    "pinnedPages",
    "notificationsState",
    "assistantChatHistory",
    "settings",
    "ui",
    "globalTheme",
    "migrationDiagnostics",
    "compatibility",
    "unknownWorkspaceFields",
    "localStorageSnapshot",
    "exportedAt"
  ],
  "syntheticWorkspaceFields": [
    "notificationsState",
    "globalTheme",
    "unknownWorkspaceFields",
    "localStorageSnapshot",
    "exportedAt"
  ],
  "workspaceFieldClassifications": {
    "version": { "category": "reconstructed", "reason": "The receiving runtime writes its supported schema version." },
    "schema": { "category": "atomic", "record": "a/schema" },
    "migrationHistory": { "category": "record", "collection": "migrationHistory" },
    "pages": { "category": "record", "collection": "pages", "orderedBy": "o/pages", "recordExclusions": ["generated Help & Docs system page"] },
    "spaces": { "category": "atomic", "record": "a/spaces" },
    "tasks": { "category": "record", "collection": "tasks", "orderedBy": "taskOrder" },
    "taskOrder": { "category": "ordered", "record": "o/taskOrder" },
    "timeBlocks": { "category": "record", "collection": "timeBlocks", "orderedBy": "o/timeBlocks" },
    "streaks": { "category": "atomic", "record": "a/streaks" },
    "habitTracker": { "category": "atomic", "record": "a/habitTracker" },
    "collegeTracker": { "category": "atomic", "record": "a/collegeTracker" },
    "academicWorkspace": { "category": "atomic", "record": "a/academicWorkspace" },
    "collegeAppWorkspace": { "category": "atomic", "record": "a/collegeAppWorkspace" },
    "lifeWorkspace": { "category": "atomic", "record": "a/lifeWorkspace" },
    "businessWorkspace": { "category": "atomic", "record": "a/businessWorkspace" },
    "apStudyWorkspace": { "category": "atomic", "record": "a/apStudyWorkspace" },
    "homeworkWorkspace": { "category": "record", "collections": ["homeworkCourses", "homeworkTasks"], "restRecord": "a/homeworkWorkspace.__rest" },
    "reviewWorkspace": { "category": "record", "collections": ["reviewDecks", "reviewItems"], "restRecord": "a/reviewWorkspace.__rest" },
    "courseWorkspace": { "category": "atomic", "record": "a/courseWorkspace", "assetContract": "courseAttachmentBytes" },
    "attachmentLinks": { "category": "record", "collection": "attachmentLinks", "orderedBy": "o/attachmentLinks", "assetContract": "courseAttachmentBytes" },
    "pdfDocuments": { "category": "record", "collection": "pdfDocuments", "orderedBy": "o/pdfDocuments", "assetContract": "courseAttachmentBytes" },
    "pdfAnnotations": { "category": "record", "collection": "pdfAnnotations", "orderedBy": "o/pdfAnnotations" },
    "schoolSchedule": { "category": "atomic", "record": "a/schoolSchedule" },
    "gradePlanner": { "category": "atomic", "record": "a/gradePlanner" },
    "semesterSetup": { "category": "atomic", "record": "a/semesterSetup" },
    "cramSessions": { "category": "atomic", "record": "a/cramSessions" },
    "trash": { "category": "record", "collection": "trash", "orderedBy": "o/trash" },
    "focusSessions": { "category": "atomic", "record": "a/focusSessions" },
    "protectedTime": { "category": "atomic", "record": "a/protectedTime" },
    "taskDependencies": { "category": "atomic", "record": "a/taskDependencies" },
    "studySessions": { "category": "atomic", "record": "a/studySessions" },
    "masteryRecords": { "category": "atomic", "record": "a/masteryRecords" },
    "confidenceObservations": { "category": "atomic", "record": "a/confidenceObservations" },
    "studentDecisionState": { "category": "atomic", "record": "a/studentDecisionState" },
    "assistantPermissions": { "category": "atomic", "record": "a/assistantPermissions" },
    "assistantMemory": { "category": "atomic", "record": "a/assistantMemory", "reason": "Inspectable Sutra 2 memory contract; distinct from user-managed Assistant long-term memory." },
    "syncAuditLog": { "category": "record", "collection": "syncAuditLog", "orderedBy": "o/syncAuditLog" },
    "workspaceMeta": { "category": "deviceLocal", "reason": "IndexedDB revision, writer-tab, and save coordination metadata." },
    "privateDocuments": { "category": "record", "collection": "privateDocuments", "orderedBy": "o/privateDocuments", "assetContract": "courseAttachmentBytes" },
    "sharedStudySessions": { "category": "atomic", "record": "a/sharedStudySessions" },
    "operatingManual": { "category": "atomic", "record": "a/operatingManual" },
    "portfolioWorkspace": { "category": "atomic", "record": "a/portfolioWorkspace" },
    "testingHub": { "category": "atomic", "record": "a/testingHub" },
    "focusTemplates": { "category": "atomic", "record": "a/focusTemplates" },
    "customTabs": { "category": "record", "collection": "customTabs", "orderedBy": "o/customTabs" },
    "splitPaneContexts": { "category": "deviceLocal", "reason": "Pane selection, layout, filters, and scroll position describe this browser's current UI." },
    "pinnedPages": { "category": "atomic", "record": "a/pinnedPages" },
    "notificationsState": { "category": "atomic", "record": "a/notificationsState", "localOnlyDescendants": ["lastActiveAt", "lastDigest", "lastWeeklyReviewAt", "lastWeeklyNudge"] },
    "assistantChatHistory": { "category": "record", "collection": "assistantConversations", "restRecord": "a/assistantChatHistory.__rest" },
    "settings": { "category": "atomic", "record": "a/settings", "localOnlyDescendants": ["dataHealth", "preferences.sync", "preferences.assistant.localEndpoint"] },
    "ui": { "category": "deviceLocal", "reason": "Active view, open page, and scroll restoration are browser context." },
    "globalTheme": { "category": "atomic", "record": "a/globalTheme" },
    "migrationDiagnostics": { "category": "atomic", "record": "a/migrationDiagnostics", "reason": "May hold the only quarantined copy of recovered user data." },
    "compatibility": { "category": "compatibility", "record": "a/compatibility", "reason": "Recovered legacy data must survive even when the current UI does not consume it." },
    "unknownWorkspaceFields": { "category": "compatibility", "record": "a/unknownWorkspaceFields", "reason": "Forward-compatible top-level fields are redacted for credential-shaped keys, encrypted, and restored by original name." },
    "localStorageSnapshot": { "category": "atomic", "record": "a/localStorageSnapshot", "reason": "Sync mode contains only explicitly allowlisted portable mirrors." },
    "exportedAt": { "category": "ephemeral", "reason": "Per-export timestamp; never part of the synchronized canonical state." }
  },
  "nestedPersistentContracts": {
    "inheritanceRule": "Every durable descendant of a synchronized record, ordered collection, or atomic section inherits that parent decision. Normalizers must preserve documented fields and forward-compatible extra fields unless a migration intentionally changes them.",
    "pages[]": ["id", "title", "type", "content", "blocks", "icon", "collapsed", "theme", "createdAt", "updatedAt", "isTemporary", "temporaryCreatedAt", "temporaryExpiresAt", "isLocked", "lockHash", "lockSalt", "lockedAt", "lockAutoLock", "lockDuressVerifier", "spaceId", "canvas", "slides", "spreadsheet", "htmlDocument", "isSystemPage", "builtInId", "systemRole", "pageMode", "documentBackground", "formatting", "documentLayout", "comments", "suggestions", "footnotes", "citations", "tags", "versions"],
    "tasks[]": ["id", "title", "notes", "priority", "difficulty", "status", "completed", "isActive", "scheduleType", "weeklyDays", "estimate", "category", "subtasks", "dependencies", "dueDate", "dueTime", "reminder", "recurrence", "noteId", "courseId", "createdAt", "updatedAt"],
    "timeBlocks[]": ["id", "name", "start", "end", "date", "category", "color", "recurrence", "weeklyDays", "recurrenceUntil", "recurrenceExceptions", "preserveRecurrence", "importedRecurrence", "isAllDay", "notes", "referenceUrl", "source", "sourceUid", "calendarImportId", "calendarName", "calendarUid", "calendarRecurrenceId", "calendarTimeZone", "calendarRrule", "createdAt", "updatedAt"],
    "assistantChatHistory": ["version", "currentChatId", "conversations", "legacyMigrationComplete"],
    "assistantChatHistory.conversations[]": ["id", "title", "messages", "createdAt", "updatedAt", "providerLabel", "modelLabel", "archived", "pinned", "scope", "restoredFromBackup"],
    "assistantChatHistory.conversations[].messages[]": ["id", "role", "content", "createdAt", "claimType", "sources", "grounding", "contextTags", "memoryUsedIds", "receipt", "providerLabel", "modelLabel", "favorite", "partial", "restoredFromBackup"],
    "courseWorkspace.files[]": ["id", "courseId", "linkedEntityType", "linkedEntityId", "name", "originalName", "mimeType", "sizeBytes", "kind", "tags", "createdAt", "updatedAt", "source", "storageType", "blobKey", "url", "description", "summary", "syncContentHash"],
    "attachmentLinks[]": ["id", "fileId", "entityType", "entityId", "createdAt"],
    "pdfDocuments[]": ["id", "fileId", "schemaVersion", "pages", "bookmarks", "checkpoints", "createdAt", "updatedAt"],
    "pdfDocuments[].pages[]": ["id", "sourceFileId", "sourcePageIndex", "order", "rotation", "width", "height", "removed"],
    "pdfDocuments[].bookmarks[]": ["id", "pageId", "title", "createdAt"],
    "pdfDocuments[].checkpoints[]": ["id", "label", "pages", "createdAt"],
    "pdfAnnotations[]": ["id", "documentId", "pageId", "type", "geometry", "style", "text", "inkPaths", "fieldKey", "value", "createdAt", "updatedAt"],
    "settings.preferences": ["appearance", "layout", "editor", "tasks", "calendar", "today", "focus", "quotes", "study", "business", "assistant", "studentPreferences", "integrations", "notifications", "accessibility", "startup", "data", "workspace", "sync"],
    "settings.preferences.assistant": ["chatMemoryDepth", "localEndpoint"],
    "settings.preferences.assistant.localEndpoint": ["enabled", "baseUrl", "model", "visionCapable"],
    "settings.preferences.today": ["priorityFocus", "dashboard"],
    "settings.preferences.today.dashboard": ["version", "preset", "order", "hidden", "sizes"],
    "settings.preferences.quotes": ["showInSidebar", "showInCustomTabs", "sourceMode", "enabledCategories", "customQuotes"],
    "settings.preferences.quotes.customQuotes[]": ["id", "text", "author", "category", "createdAt", "updatedAt"],
    "homeworkWorkspace": ["schemaVersion", "revision", "courses", "tasks", "quarantine", "updatedAt", "lastMutation"],
    "reviewWorkspace": ["decks", "items", "sessions", "settings"]
  },
  "assetContracts": {
    "courseAttachmentBytes": {
      "category": "asset",
      "covers": ["course attachments", "note attachments stored through Course Hub", "imported files", "private-document bytes"],
      "address": "SHA-256 of the stored data URL",
      "routing": "Opaque content hash; plaintext filenames are not used in object paths",
      "encryption": "Fresh-IV AES-GCM envelope with authenticated vault/asset metadata",
      "hydration": "The receiving file record remains missingBlob/pending until bytes decrypt, hash-verify, and persist in noteflow_attachments_db"
    },
    "inlinePageAssets": {
      "category": "asset",
      "covers": ["inline note images", "document background images", "handwriting data embedded in page content"],
      "transport": "Embedded inside the encrypted page operation or encrypted compaction snapshot",
      "plaintextRoutingMetadata": false
    }
  },
  "localStorageSnapshotKeys": [
    "noteflow_focus_timer",
    "streakApp:settings",
    "chat_provider",
    "chat_model_by_provider",
    "chat_custom_model_by_provider",
    "noteflow.feedback.googleEmbed.v1",
    "sutra:activityLog:v1",
    "flow:activityLog:v1",
    "sutraNotifications:v1",
    "sutra:assistantMemory:v1",
    "sutra:starterPacks:custom:v1",
    "hwCountdownPins:v1"
  ],
  "localStorageClassifications": {
    "noteflow_focus_timer": { "category": "reconstructed", "canonical": "settings.focusTimer" },
    "streakApp:settings": { "category": "reconstructed", "canonical": "settings.soundEnabled and settings.hapticEnabled" },
    "chat_provider": { "category": "atomic", "canonical": "localStorageSnapshot.chat_provider" },
    "chat_model_by_provider": { "category": "atomic", "canonical": "localStorageSnapshot.chat_model_by_provider" },
    "chat_custom_model_by_provider": { "category": "atomic", "canonical": "localStorageSnapshot.chat_custom_model_by_provider" },
    "noteflow.feedback.googleEmbed.v1": { "category": "ephemeral", "backupOnly": true, "reason": "Regenerable feedback-form URL cache whose updatedAt is rewritten on every startup; excluded from sync to prevent churn." },
    "sutra:activityLog:v1": { "category": "atomic", "canonical": "localStorageSnapshot.sutra:activityLog:v1" },
    "flow:activityLog:v1": { "category": "compatibility", "canonical": "localStorageSnapshot.flow:activityLog:v1" },
    "sutraNotifications:v1": { "category": "reconstructed", "canonical": "notificationsState" },
    "sutra:assistantMemory:v1": { "category": "atomic", "canonical": "localStorageSnapshot.sutra:assistantMemory:v1" },
    "sutra:starterPacks:custom:v1": { "category": "atomic", "canonical": "localStorageSnapshot.sutra:starterPacks:custom:v1" },
    "hwCountdownPins:v1": { "category": "atomic", "canonical": "localStorageSnapshot.hwCountdownPins:v1" },
    "sutra:assistantChats:v1": { "category": "reconstructed", "canonical": "assistantChatHistory" },
    "sutra:assistantCurrentChatId:v1": { "category": "reconstructed", "canonical": "assistantChatHistory.currentChatId" },
    "sutra_startup_sound": { "category": "reconstructed", "canonical": "settings.preferences.startup.playSound" },
    "sutra:activation:v1": { "category": "deviceLocal", "reason": "Explicitly device-scoped activation counters." },
    "sutra:persistenceHealth:v1": { "category": "deviceLocal", "reason": "This device's save/readback health, including a compact last-confirmed workspace hash used only to verify missing-root recovery." },
    "sutra:assistantSidebarWidth:v1": { "category": "deviceLocal", "reason": "Viewport-specific layout." },
    "sutra:workspaceSnapshots:v1": { "category": "deviceLocal", "reason": "Local safety moments are backups, not replicated live state." },
    "sutra:recentCommands:v1": { "category": "ephemeral", "reason": "Regenerable recency cache." },
    "sutra_ai_send_ack_v1": { "category": "deviceLocal", "reason": "Per-browser network-disclosure acknowledgement." },
    "chat_models_cache_*": { "category": "ephemeral", "reason": "Regenerable provider-model cache." },
    "sutra:googleDriveSync:v1": { "category": "deviceLocal", "reason": "Google Drive backup operational metadata." },
    "sutra:supabaseCloud:v1": { "category": "deviceLocal", "reason": "Version-2 Cloud backup operational metadata: opt-in, cadence, successful snapshot timestamps and cross-tab automatic-backup hash receipt. Frozen storage key; migration preserves unknown fields. Never exported or synchronized." },
    "sutra:cloudProvider:*": { "category": "secret", "reason": "Provider configuration may contain credentials." },
    "sutra:supabaseSession:v1": { "category": "secret", "reason": "Supabase access/refresh session." },
    "sutra:syncAccountHint:v1": { "category": "deviceLocal", "reason": "Non-secret account routing hint used only to select this browser's account-scoped sync operational namespace; never exported or synchronized." },
    "sutra:revocationWipeGuard:v1": { "category": "deviceLocal", "reason": "Fail-closed, content-free sentinel that prevents a revoked browser from reopening or rewriting deleted workspace data." }
  },
  "otherStorageClassifications": {
    "noteflow_atelier_db.workspace.root": { "category": "reconstructed", "reason": "Canonical local working copy; portable descendants are projected according to workspaceFieldClassifications." },
    "noteflow_atelier_db.workspace.workspace-last-meaningful": { "category": "deviceLocal", "reason": "One-generation local recovery journal written atomically beside the canonical root; never exported or synchronized separately." },
    "noteflow_atelier_db.workspace.workspace-empty-before-recovery": { "category": "deviceLocal", "reason": "Diagnostic copy of an empty/default root preserved before automatic recovery promotes a richer local candidate." },
    "noteflow_atelier_db.workspace.workspace-confirmed-root": { "category": "deviceLocal", "reason": "Compact data-presence marker written atomically with canonical commits so a deliberate empty workspace is never mistaken for an unexplained reset." },
    "noteflow_attachments_db.blobs": { "category": "asset", "reason": "Required referenced bytes use assetContracts.courseAttachmentBytes." },
    "sutra_credentials_db": { "category": "secret", "reason": "Optional device-local credential vault. Remembered Assistant API keys and Sutra Cloud refresh tokens are AES-GCM encrypted, account/backend scoped where applicable, never exported or synchronized, and removed by verified origin wipe." },
    "sutra_sync_db": { "category": "deviceLocal", "reason": "Account-scoped outboxes, baselines, cursors, tombstones, dedicated conflict-review records/resolved tombstones, device registration state, wrapped keys, and refresh tokens are sync operations, not workspace payload. The browser never opens one account namespace through another account's sync runtime. Conflict resolutions themselves synchronize as encrypted syncAuditLog records." },
    "sutra-drive-sync-keys": { "category": "secret", "reason": "Device-local wrapped/derived Google Drive backup key material." },
    "sutra-fs-config": { "category": "deviceLocal", "reason": "File-system backup directory handle." },
    "sutra_share_target_db": { "category": "ephemeral", "reason": "Temporary incoming share payload." },
    "sessionStorage": { "category": "ephemeral", "reason": "In-flight chat context, session-only API keys, UI scroll restoration, Safe Mode, and a bounded same-tab immediate-reload journal for unlocked notes never enter sync. PIN-locked note plaintext is excluded from that journal. Remembered credentials use the encrypted device-local credential vault instead." }
  },
  "deliberateExclusions": [
    "AI provider API keys and model secrets",
    "Optional remembered AI provider keys and Sutra Cloud refresh tokens",
    "OAuth credentials and raw access, refresh, and ID tokens",
    "Supabase sessions and the publishable client configuration",
    "passwords and backup or sync passphrases",
    "recovery keys, unwrapped vault keys, and passphrase-derived encryption keys",
    "Google Drive and backup-provider operational metadata",
    "sync queues, baselines, cursors, tombstones, device IDs, and conflict-store records",
    "active view, pane layout, scroll positions, temporary modal state, and in-session unlocked-page state",
    "in-flight Assistant requests, abort controllers, streaming buffers, typing indicators, and token/latency diagnostics",
    "provider-model caches, command recency caches, and temporary share-target payloads"
  ]
}
